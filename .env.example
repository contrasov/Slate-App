APP_NAME=Slate
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Development-only password; change it before using a non-local environment.
POSTGRES_PASSWORD=local-dev-password

DB_CONNECTION=pgsql
